# Data preparation: raw Parquet -> canonical CSV scale factors
GRBENCH_RAW_ROOT=data/raw
SCISCINET_PARQUET_ROOT=data/raw/sciscinet-v2
GRBENCH_DATA_ROOT=data/processed
SCISCINET_CSV_ROOT=data/processed/sf10_4
GRBENCH_UPDATE_DIR=.local/update-staging
GRBENCH_DUCKDB_ROOT=.local/duckdb
GRBENCH_LOCAL_ROOT=.local
GRBENCH_LOG_ROOT=.local/logs
GRBENCH_RUN_RESULTS_ROOT=.local/results

# Common benchmark settings
GRBENCH_THREADS=8
GRBENCH_TIMEOUT_S=18000
GRBENCH_WARMUPS=1
GRBENCH_REPEATS=3
GRBENCH_SAMPLE_INTERVAL_S=0.01

# Engine installations
ORIENTDB_HOME=.local/orientdb-community-3.2.37
GRBENCH_ORIENTDB_DB_ROOT=.local/orientdb-databases
GRBENCH_ORIENTDB_ORACLE=.local/orientdb-oracle.json
JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
ORIENTDB_USERNAME=admin
ORIENTDB_PASSWORD=
ORIENTDB_IMAGE=orientdb:3.2.37

# Supply secret values in the process environment or an ignored local file;
# never commit them. OrientDB refuses to run with a blank password.
ARANGODB_ENDPOINT=http://127.0.0.1:8529
ARANGODB_SHELL_ENDPOINT=tcp://127.0.0.1:8529
ARANGODB_DATABASE=grbench
ARANGODB_USERNAME=root
ARANGODB_PASSWORD=
ARANGODB_IMAGE=arangodb:3.12.4
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=grbench
POSTGRES_USERNAME=grbench
POSTGRES_PASSWORD=
POSTGRES_AGE_IMAGE=apache/age:release_PG15_1.6.0
GRBENCH_POSTGRES_PREPARED_ROOT=.local/prepared
GRBENCH_POSTGRES_UPDATE_PREPARED_ROOT=
POSTGRES_CGROUP_PATH=
AGENSGRAPH_DATABASE=grbench
AGENSGRAPH_USERNAME=agens
AGENSGRAPH_PASSWORD=
AGENSGRAPH_IMAGE=bitnine/agensgraph:v2.14.1
DUCKDB_IMAGE=duckdb/duckdb:1.2.2
GRAINDB_IMAGE=grbench/graindb:be901b3
